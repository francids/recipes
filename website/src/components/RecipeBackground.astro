---
import lightHexagonSvg from "../assets/light-hexagon.svg";
import darkHexagonSvg from "../assets/dark-hexagon.svg";
---

<div
  class="pointer-events-none absolute inset-0 z-0 overflow-hidden bg-linear-to-b from-main/5 via-main/2 to-white select-none dark:from-main/10 dark:via-main/5 dark:to-zinc-900"
>
  <div
    id="bg-pattern"
    class="lateral-pattern-mask absolute inset-0 opacity-25 transition-opacity duration-500 animate-scroll-bg dark:opacity-15"
    style={{
      backgroundSize: "125px",
      backgroundRepeat: "repeat",
    }}
  >
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-48 bg-linear-to-t from-white via-white/70 to-transparent dark:from-zinc-900 dark:via-zinc-900/70"
  >
  </div>
</div>

<script define:vars={{ lightHexagonSvg, darkHexagonSvg }}>
  const lightBg = `url("${lightHexagonSvg.src}")`;
  const darkBg = `url("${darkHexagonSvg.src}")`;

  function updateBackground(theme) {
    const bgPattern = document.getElementById("bg-pattern");
    if (bgPattern) {
      bgPattern.style.backgroundImage = theme === "dark" ? darkBg : lightBg;
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    if (typeof window !== "undefined" && window.themeManager) {
      updateBackground(window.themeManager.getState().theme);
      window.themeManager.subscribe((state) => {
        updateBackground(state.theme);
      });
    }
  });
</script>

<style>
  .lateral-pattern-mask {
    -webkit-mask-image: radial-gradient(
      ellipse 50% 65% at 50% 38%,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.65) 55%,
      rgba(0, 0, 0, 1) 100%
    );
    mask-image: radial-gradient(
      ellipse 50% 65% at 50% 38%,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.65) 55%,
      rgba(0, 0, 0, 1) 100%
    );
  }

  @keyframes scroll-bg {
    0% {
      background-position: 0px 0px;
    }
    25% {
      background-position: 62.5px 62.5px;
    }
    50% {
      background-position: 125px 125px;
    }
    75% {
      background-position: 187.5px 187.5px;
    }
    100% {
      background-position: 250px 250px;
    }
  }

  .animate-scroll-bg {
    animation: scroll-bg 40s linear infinite;
  }
</style>
