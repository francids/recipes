---
import type Feature from "../interfaces/feature";

interface Props {
  feature: Feature;
}
const { feature } = Astro.props;
---

<div
  class="flex flex-col justify-center items-start text-left w-full rounded-lg border border-orange-200 bg-orange-50/30 dark:border-main/40 dark:bg-zinc-800/40 p-6 lg:p-8"
>
  <h3
    class="text-lg sm:text-xl font-semibold mb-2 text-zinc-900 dark:text-zinc-100"
  >
    {feature.title}
  </h3>
  <p
    class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed"
  >
    {feature.description}
  </p>
</div>
