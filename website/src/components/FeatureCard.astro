---
import type Feature from "../interfaces/feature";

interface Props {
  feature: Feature;
}

const { feature } = Astro.props;
---

<div
  class="feature-text-item h-full py-7 text-left md:px-8 md:py-8 md:first:pl-0 md:last:pr-0"
>
  <h3
    class="text-lg sm:text-xl font-semibold mb-2 text-zinc-900 dark:text-zinc-100"
  >
    {feature.title}
  </h3>
  <p
    class="text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400"
  >
    {feature.description}
  </p>
</div>
