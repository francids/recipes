---
import type Feature from "../interfaces/feature";

interface Props {
  feature: Feature;
}

const { feature } = Astro.props;
---

<div
  class="flex flex-col sm:flex-row w-full rounded-lg border border-orange-200 bg-orange-50/30 dark:border-main/40 dark:bg-zinc-800/40 overflow-hidden"
>
  <div
    class="flex flex-col justify-center items-start flex-1 p-6 lg:p-8 text-left"
  >
    <h3
      class="text-lg sm:text-xl font-semibold mb-2 text-zinc-900 dark:text-zinc-100"
    >
      {feature.title}
    </h3>
    <p
      class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed"
    >
      {feature.description}
    </p>
  </div>
  <div
    class="w-full sm:w-52 md:w-56 xl:w-64 shrink-0 aspect-square border-t sm:border-t-0 sm:border-l border-orange-200 dark:border-main/40 overflow-hidden select-none"
  >
    <img
      src={typeof feature.lightImage === "string"
        ? feature.lightImage
        : feature.lightImage?.src || ""}
      alt={feature.title}
      width={1000}
      height={1000}
      draggable="false"
      class="w-full h-full aspect-square object-cover block dark:hidden select-none pointer-events-none"
      loading="lazy"
    />
    <img
      src={typeof feature.darkImage === "string"
        ? feature.darkImage
        : feature.darkImage?.src || ""}
      alt={feature.title}
      width={1000}
      height={1000}
      draggable="false"
      class="w-full h-full aspect-square object-cover hidden dark:block select-none pointer-events-none"
      loading="lazy"
    />
  </div>
</div>
