---
import Logotype from "./Logotype.astro";
import RecipeBackground from "./RecipeBackground.astro";

import LightInicialScreen from "../assets/light-inicial-screen.webp";
import DarkInicialScreen from "../assets/dark-inicial-screen.webp";
import LightRecipeScreen from "../assets/light-recipe-screen.webp";
import DarkRecipeScreen from "../assets/dark-recipe-screen.webp";
import {
  createTranslationHelper,
  resolveLocale,
  type Locale,
} from "@/utils/i18n";

const locale: Locale = resolveLocale(Astro.currentLocale);
const t = await createTranslationHelper(locale);
---

<section
  class="text-zinc-900 dark:text-zinc-100 pt-20 pb-16 px-8 text-center relative overflow-hidden selection:bg-white/25"
>
  <RecipeBackground />
  <div
    class="max-w-7xl mx-auto flex flex-col items-center gap-12 relative z-10"
  >
    <div class="max-w-md mx-auto text-center">
      <div class="flex items-center justify-center mb-4 w-full">
        <Logotype class="w-20 h-8 text-main dark:text-amber-500" />
      </div>
      <h1 class="md:leading-12 text-4xl md:text-5xl font-bold mb-4">
        {t("HeroSection.title")}
      </h1>
      <p
        class="text-zinc-600 dark:text-zinc-400 md:leading-8 text-lg md:text-xl"
      >
        {t("HeroSection.description")}
      </p>
    </div>

    <div class="flex flex-col items-center justify-center">
      <div
        class="flex justify-center items-center gap-6 md:gap-12 flex-wrap select-none"
      >
        <div
          class="w-56 md:w-72 transition-all duration-500 hover:-translate-y-2 hover:-rotate-1 -rotate-3 relative"
        >
          <img
            src={LightInicialScreen.src}
            alt="App initial screen"
            width={320}
            height={640}
            draggable="false"
            class="transition-opacity duration-300 rounded-lg block dark:hidden select-none pointer-events-none"
          />
          <img
            src={DarkInicialScreen.src}
            alt="App initial screen"
            width={320}
            height={640}
            draggable="false"
            class="transition-opacity duration-300 rounded-lg hidden dark:block select-none pointer-events-none"
          />
        </div>
        <div
          class="w-56 md:w-72 transition-all duration-500 hover:-translate-y-2 hover:rotate-1 rotate-3 relative"
        >
          <img
            src={LightRecipeScreen.src}
            alt="App recipe screen"
            width={320}
            height={640}
            draggable="false"
            class="transition-opacity duration-300 rounded-lg block dark:hidden select-none pointer-events-none"
          />
          <img
            src={DarkRecipeScreen.src}
            alt="App recipe screen"
            width={320}
            height={640}
            draggable="false"
            class="transition-opacity duration-300 rounded-lg hidden dark:block select-none pointer-events-none"
          />
        </div>
      </div>
    </div>
  </div>
</section>
