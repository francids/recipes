---
import type { Theme } from "../types/theme";
import {
  createTranslationHelper,
  resolveLocale,
  type Locale,
} from "../utils/i18n.ts";

const locale: Locale = resolveLocale(Astro.currentLocale);
const t = await createTranslationHelper(locale);

const storedTheme = Astro.cookies.get("theme")?.value;
const currentTheme: Theme =
  storedTheme === "light" || storedTheme === "dark" || storedTheme === "system"
    ? storedTheme
    : "system";
---

<footer
  class="border-t border-zinc-200/80 bg-zinc-50/80 px-6 py-8 text-zinc-600 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-400"
>
  <div
    class="mx-auto flex max-w-7xl flex-col-reverse items-center justify-between gap-6 sm:flex-row"
  >
    <p class="text-center text-sm sm:text-left">
      {
        t("Footer.copyright", undefined, {
          year: new Date().getFullYear().toString(),
        })
      }
    </p>

    <div class="flex items-center gap-3">
      <span
        class="hidden text-xs font-medium tracking-wide text-zinc-500 sm:inline dark:text-zinc-400"
      >
        {t("Footer.theme_label")}
      </span>
      <div
        id="theme-toggle"
        role="group"
        aria-label={t("Footer.theme_label")}
        class="inline-flex items-center gap-0.5 rounded-md border border-zinc-200/80 bg-white/80 p-1 shadow-sm dark:border-zinc-700/60 dark:bg-zinc-900/80"
      >
        <button
          type="button"
          data-theme="light"
          aria-label={t("Footer.theme_light")}
          title={t("Footer.theme_light")}
          aria-pressed={currentTheme === "light"}
          class="flex size-8 cursor-pointer items-center justify-center rounded-md text-zinc-500 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/60 aria-pressed:bg-orange-500 aria-pressed:text-white aria-pressed:shadow-sm not-aria-pressed:hover:bg-zinc-100 not-aria-pressed:hover:text-zinc-900 dark:text-zinc-400 dark:not-aria-pressed:hover:bg-zinc-800 dark:not-aria-pressed:hover:text-zinc-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4.5"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </button>

        <button
          type="button"
          data-theme="dark"
          aria-label={t("Footer.theme_dark")}
          title={t("Footer.theme_dark")}
          aria-pressed={currentTheme === "dark"}
          class="flex size-8 cursor-pointer items-center justify-center rounded-md text-zinc-500 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/60 aria-pressed:bg-orange-500 aria-pressed:text-white aria-pressed:shadow-sm not-aria-pressed:hover:bg-zinc-100 not-aria-pressed:hover:text-zinc-900 dark:text-zinc-400 dark:not-aria-pressed:hover:bg-zinc-800 dark:not-aria-pressed:hover:text-zinc-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4.5"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <button
          type="button"
          data-theme="system"
          aria-label={t("Footer.theme_system")}
          title={t("Footer.theme_system")}
          aria-pressed={currentTheme === "system"}
          class="flex size-8 cursor-pointer items-center justify-center rounded-md text-zinc-500 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/60 aria-pressed:bg-orange-500 aria-pressed:text-white aria-pressed:shadow-sm not-aria-pressed:hover:bg-zinc-100 not-aria-pressed:hover:text-zinc-900 dark:text-zinc-400 dark:not-aria-pressed:hover:bg-zinc-800 dark:not-aria-pressed:hover:text-zinc-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4.5"
            aria-hidden="true"
            focusable="false"
          >
            <rect width="20" height="14" x="2" y="3" rx="2"></rect>
            <line x1="8" x2="16" y1="21" y2="21"></line>
            <line x1="12" x2="12" y1="17" y2="21"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  type Theme = "light" | "dark" | "system";

  const themeToggle = document.getElementById("theme-toggle");
  const themeOptions = Array.from(
    themeToggle?.querySelectorAll<HTMLButtonElement>("[data-theme]") ?? [],
  );

  function syncThemeSelection(theme: Theme) {
    themeOptions.forEach((option) => {
      option.setAttribute(
        "aria-pressed",
        String(option.dataset.theme === theme),
      );
    });
  }

  function initThemeToggle() {
    if (!window.themeManager) return;

    syncThemeSelection(window.themeManager.getState().theme);
    window.themeManager.subscribe(({ theme }) => syncThemeSelection(theme));

    themeOptions.forEach((option) => {
      option.addEventListener("click", () => {
        window.themeManager.setTheme(option.dataset.theme as Theme);
      });
    });
  }

  if (document.readyState === "complete") {
    initThemeToggle();
  } else {
    document.addEventListener("DOMContentLoaded", initThemeToggle, {
      once: true,
    });
  }
</script>
