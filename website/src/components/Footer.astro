---
import {
  createTranslationHelper,
  resolveLocale,
  type Locale,
} from "../utils/i18n.ts";

const locale: Locale = resolveLocale(Astro.currentLocale);
const t = await createTranslationHelper(locale);
---

<footer
  class="border-t border-zinc-200/80 bg-zinc-50/80 px-6 py-8 text-zinc-600 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-400"
>
  <div class="mx-auto max-w-7xl">
    <p class="text-center text-sm">
      {
        t("Footer.copyright", undefined, {
          year: new Date().getFullYear().toString(),
        })
      }
    </p>
  </div>
</footer>
