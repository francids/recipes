---
import FullFeatureCard from "./FullFeatureCard.astro";
import FeatureCard from "./FeatureCard.astro";
import type Feature from "../interfaces/feature";

import LightAiComponent from "@/assets/light-ai-component.png";
import DarkAiComponent from "@/assets/dark-ai-component.png";
import LightShareComponent from "@/assets/light-share-component.png";
import DarkShareComponent from "@/assets/dark-share-component.png";
import {
  createTranslationHelper,
  resolveLocale,
  type Locale,
} from "@/utils/i18n";

const locale: Locale = resolveLocale(Astro.currentLocale);
const t = await createTranslationHelper(locale);

const features: Feature[] = [
  {
    title: t("FeaturesSection.feature5_title"),
    description: t("FeaturesSection.feature5_description"),
    lightImage: LightAiComponent,
    darkImage: DarkAiComponent,
  },
  {
    title: t("FeaturesSection.feature4_title"),
    description: t("FeaturesSection.feature4_description"),
    lightImage: LightShareComponent,
    darkImage: DarkShareComponent,
  },
  {
    title: t("FeaturesSection.feature1_title"),
    description: t("FeaturesSection.feature1_description"),
  },
  {
    title: t("FeaturesSection.feature3_title"),
    description: t("FeaturesSection.feature3_description"),
  },
  {
    title: t("FeaturesSection.feature6_title"),
    description: t("FeaturesSection.feature6_description"),
  },
];
---

<section
  id="features"
  class="min-h-screen py-16 px-6 md:px-8 bg-white dark:bg-zinc-900 flex flex-col justify-center"
>
  <div class="max-w-7xl w-full mx-auto">
    <h2
      class="text-3xl md:text-4xl font-bold tracking-tight mb-10 text-main dark:text-amber-500 text-center md:text-left"
    >
      {t("FeaturesSection.title")}
    </h2>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12 lg:gap-8">
      {
        features.map((feature, index) => {
          if (feature.darkImage && feature.lightImage) {
            return (
              <div class="lg:col-span-6">
                <div
                  class="feature-float"
                  style={`animation-delay: -${index * 1.4}s;`}
                >
                  <div
                    class="feature-tilt"
                    style={`--card-tilt: ${index % 2 === 0 ? "-0.5deg" : "0.5deg"};`}
                  >
                    <FullFeatureCard feature={feature} reverse={index === 1} />
                  </div>
                </div>
              </div>
            );
          }
        })
      }
    </div>

    <div
      class="mt-12 border-t border-zinc-200/80 lg:mt-16 dark:border-zinc-800"
    >
      <div
        class="grid grid-cols-1 divide-y divide-zinc-200 md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-zinc-800"
      >
        {
          features.map((feature) => {
            if (!feature.darkImage && !feature.lightImage) {
              return <FeatureCard feature={feature} />;
            }
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes featureCardFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2px);
    }
  }

  .feature-float {
    animation: featureCardFloat 9s ease-in-out infinite;
    will-change: transform;
  }

  .feature-tilt {
    transform: rotate(var(--card-tilt, 0deg));
    transition: transform 400ms ease;
  }

  .feature-tilt:hover {
    transform: rotate(0deg) translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-float {
      animation: none;
    }

    .feature-tilt {
      transition: none;
    }

    .feature-tilt:hover {
      transform: rotate(var(--card-tilt, 0deg));
    }
  }
</style>
